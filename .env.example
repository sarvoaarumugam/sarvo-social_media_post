# Copy this file to .env and fill in the values below.
# Only OPENAI_API_KEY and MONGODB_URI are required to start the app —
# everything else has a sensible default in app/core/config.py and only
# needs to be set here if you want to override it.

# --- OpenAI (required) ---
OPENAI_API_KEY=

# --- MongoDB Atlas (required) ---
MONGODB_URI=
MONGODB_DB=sarvo_podcast

# --- Application (optional overrides) ---
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- OpenAI models (optional overrides) ---
OPENAI_SCRIPT_MODEL=gpt-5.5
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_IMAGE_MODEL=gpt-image-1

# --- YouTube OAuth (desktop app) ---
# Path to the Google Cloud OAuth client-secret JSON you download from the
# Google Cloud Console (Desktop app credentials). token.json is generated
# automatically the first time you authorize (see scripts/youtube_auth.py).
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=token.json
